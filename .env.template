# AI API Keys - Configure the ones you want to use
# Claude API Key - Get from https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-YOUR-CLAUDE-API-KEY-HERE

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-YOUR-OPENAI-API-KEY-HERE

# Application Review uses a private one-time code for first-time browser setup.
# After setup, change the shared passphrase in Manage Reviews > Access Settings.
# Optional recovery override: node set-application-review-passphrase.js
# The recovery tool writes a hash to .env; never put an actual passphrase here.
# APPLICATION_REVIEW_PASSPHRASE_HASH=scrypt$<salt>$<hash>
